{
  "name": "nextjs-github-pages",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "yarn typecheck && next build",
    "typecheck": "next typegen && tsc --noEmit",
    "start": "next start",
    "format": "prettier --check './{bin,lib,src,tests}/**/*.{ts,tsx}'",
    "format:auto": "prettier --write './{bin,lib,src,tests}/**/*.{ts,tsx}'",
    "lint": "eslint './{bin,lib,src,tests}/**/*.{ts,tsx}' --max-warnings=0",
    "lint:filename": "node scripts/lint-filename.js"
  },
  "dependencies": {
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@lottiefiles/dotlottie-react": "^0.21.1",
    "@mui/icons-material": "^9.5.0",
    "@mui/material": "^9.5.0",
    "@mui/material-nextjs": "^9.5.0",
    "@next/third-parties": "^16.4.5",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "^0.35.5",
    "swiper": "^14.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@eslint-react/eslint-plugin": "^5.30.1",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "8.72.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "glob": "^14.0.4",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.72.1"
  }
}
